{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rems08/infrastructure-as-coolify/internal/resource/project",
  "$ref": "#/$defs/Project",
  "$defs": {
    "Project": {
      "properties": {
        "api_version": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ProjectMeta"
        },
        "spec": {
          "$ref": "#/$defs/ProjectSpec"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "api_version",
        "kind",
        "metadata",
        "spec"
      ]
    },
    "ProjectMeta": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "ProjectSpec": {
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
